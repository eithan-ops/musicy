{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:code(\\d{4})",
      "destination": "/"
    },
    {
      "source": "/c/:id",
      "destination": "/"
    },
    {
      "source": "/ear",
      "destination": "/"
    },
    {
      "source": "/t/:id",
      "destination": "/"
    },
    {
      "source": "/class",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/tracks/(.*)\\.(flac|m4a)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/tracks/index.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(chars|icons|og)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}